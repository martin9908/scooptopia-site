# Base project URL only — do NOT append /rest/v1/ (the supabase-js client adds it)
# Correct:   https://<project-ref>.supabase.co
# Incorrect: https://<project-ref>.supabase.co/rest/v1/
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: storage bucket for admin image uploads (defaults to "site-assets")
SUPABASE_STORAGE_BUCKET=

# Admin auth (protects /admin and /api/admin)
# ADMIN_PASSWORD: the shared password for the /admin login form
# ADMIN_SESSION_SECRET: random secret used to sign the session cookie
#   generate with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
